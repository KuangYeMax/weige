VISION_PROVIDER=mock
IMAGE_PROVIDER=mock

# 调度图片生成（dispatch）
DISPATCH_IMAGE_PROVIDER=bailian
# DISPATCH_IMAGE_MODEL=    # 留空则用 BAILIAN_IMAGE_MODEL

# 火山引擎 (Volcengine)
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_VISION_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_IMAGE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_VISION_MODEL=doubao-seed-1-6-flash-250828
ARK_IMAGE_MODEL=doubao-seedream-5-0-260128
VOLC_IMAGE_MODEL=doubao-seedream-4-0-250828

# DeepSeek
DEEPSEEK_API_KEY=

# 阿里云百炼 (DashScope)
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
DASHSCOPE_COMPAT_BASE_URL=
DASHSCOPE_REGION=cn-beijing
BAILIAN_IMAGE_MODEL=wan2.7-image-pro

# 参考图处理
SHRINK_REFERENCE=true

# 后期调色
POST_GRADE=true
GRADE_SATURATION=0.75
GRADE_HIGHLIGHT=0.88
GRADE_CONTRAST=0.93
GRADE_GRAIN=0.015

# 真实感随机变量池
REALISM_POOL=true
# REALISM_SEED=       # 固定后可复现同一组合，留空则每次随机

# 生图提示词策略：legacy（现有逻辑）| scale_anchor（锚点比例）
IMAGE_PROMPT_STRATEGY=legacy
# 写实度增强：off | on（正交于策略，两种策略均可叠加）
IMAGE_REALISM_BOOST=off

# 生图 prompt 注入控制（消融证实：开启会导致保真丢失，禁止设为 true）
INJECT_APPEARANCE_INTO_IMAGE_PROMPT=false
# 百炼 thinking_mode（无注入时安全，有注入时放大失真）
BAILIAN_THINKING_MODE=true

# 好评文案
REVIEW_PROVIDER=ark
ARK_REVIEW_BASE_URL=
ARK_REVIEW_MODEL=doubao-seed-1-6-flash-250828
REVIEW_TEMPERATURE=1.0
REVIEW_MAX_RETRIES_ON_FORBIDDEN=2
REVIEW_FALLBACK_TEXT=已收到商品，整体符合描述。
REVIEW_FORBIDDEN_WORDS_HARD=["最好","最佳","销量第一","全网第一","独家","绝无仅有","史无前例","顶级品牌","百分百","100%纯","好评返现","加微信","私聊","退款","投诉","举报","差评"]
REVIEW_FORBIDDEN_WORDS_SOFT=["总的来说","综上所述","毋庸置疑","值得推荐","品质卓越","匠心","性价比超高"]
REVIEW_COLLOQUIAL_POOL=["好看","漂亮","精致","有质感","上档次","颜值高","质量好","做工好","手感好","扎实","喜欢","满意","推荐","回购","没失望","实用","方便","真心不错","对得起价格","划算","值"]
REVIEW_MINOR_FLAW_DEFAULTS=["包装可以再好一点","物流速度一般","客服回复可以再及时一点"]

# 微信桌面版 UIA（仅 Windows）
WECHAT_SEARCH_BAR_X=170
WECHAT_SEARCH_BAR_Y=48
WECHAT_INPUT_X_OFFSET=750
WECHAT_INPUT_Y_OFFSET=40
WECHAT_SEND_INTERVAL_MIN=1.0
WECHAT_SEND_INTERVAL_MAX=3.0
